{
  "manifest_version": 3,
  "name": "Cyber Raksha AI — Browser Shield",
  "version": "1.3.0",
  "description": "Proactive Chromium web protection powered by Cyber Raksha AI detection engine, phishing classifiers, declarative network threat intelligence blocking, and intelligent real-time security alerts.",
  "permissions": [
    "declarativeNetRequest",
    "activeTab",
    "contextMenus",
    "storage",
    "alarms",
    "notifications",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cyber Raksha AI — Web Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "warning.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
