# ==============================================================================
# Cyber Raksha AI - Production Environment Variables Template
# Stage 8: Security Hardening & Production Configuration
# ==============================================================================

APP_NAME="Cyber Raksha AI"
APP_ENV=production
APP_VERSION=1.0.0
STAGE="Stage 8: Final System Integration, Security Hardening & Deployment"
DEBUG=False
API_V1_STR=/api/v1

# SQLite local database (or set postgresql://user:password@host:5432/cyberraksha)
DATABASE_URL=sqlite:///./cyber_raksha.db

HOST=0.0.0.0
PORT=8000

# Strictly whitelist your production web domain(s)
CORS_ORIGINS=https://cyberraksha.example.org,https://api.cyberraksha.example.org

# Rate Limiting
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=30

# Threat Feed Sync (URLhaus)
THREAT_FEED_SYNC_INTERVAL_HOURS=6

