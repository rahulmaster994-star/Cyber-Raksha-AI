# Cyber Raksha AI - Environment Configuration
APP_NAME="Cyber Raksha AI"
APP_ENV="development"
APP_VERSION="1.0.0-rc.1"
DEBUG=True
API_V1_STR="/api/v1"
# Security Keys (Generate strong 32-byte hex keys for production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY="cyber-raksha-admin-secret-key-2026"
CYBER_RAKSHA_SMS_PEPPER="CYBER_RAKSHA_MOBILE_SMS_PEPPER_V2_1"

# Database Configuration (SQLite default, PostgreSQL-ready)
DATABASE_URL="sqlite:///./cyber_raksha.db"

# Server Host and Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
