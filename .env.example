# ==============================================================================
# Cyber Raksha AI - Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with production values.
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
DEBUG=True
APP_NAME=Cyber Raksha AI

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Authentication Keys (MUST be at least 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=change-me-to-a-secure-random-32-char-string-in-production
CYBER_RAKSHA_SMS_PEPPER=change-me-to-a-secure-random-32-char-string-in-production

# Database Connection URL
# SQLite (Local Development): sqlite:///./cyber_raksha.db
# PostgreSQL (Production / Neon / Supabase): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///./cyber_raksha.db

# AI Inference Engine Directory
AI_ENGINE_PATH=../ai_engine

# Cross-Origin Resource Sharing (CORS) Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Threat Intelligence Feed Update Frequency (Hours)
THREAT_FEED_SYNC_INTERVAL_HOURS=1

